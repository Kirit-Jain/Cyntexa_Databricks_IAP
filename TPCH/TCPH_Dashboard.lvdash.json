    {
      "name": "sales_analysis",
      "displayName": "Sales Analysis (TPC-H Gold)",
      "config": {
        "source": "SELECT\n  f.order_key,\n  f.order_date,\n  f.customer_key,\n  f.customer_market_segment,\n  f.product_key,\n  f.supplier_key,\n  f.ship_mode,\n  f.ship_date,\n  f.quantity,\n  f.extended_price,\n  f.discount_rate,\n  f.tax_rate,\n  c.customer_name,\n  g.nation_name AS customer_nation,\n  g.region_name AS customer_region,\n  p.product_name,\n  s.supplier_name,\n  s.supplier_nation_name AS supplier_nation,\n  s.supplier_region_name AS supplier_region\nFROM tpch_dev.gold.fact_sales AS f\nLEFT JOIN tpch_dev.gold.dim_customer AS c\n  ON f.customer_key = c.customer_key\nLEFT JOIN tpch_dev.gold.dim_geography AS g\n  ON f.customer_nation_key = g.geography_key\nLEFT JOIN tpch_dev.gold.dim_product AS p\n  ON f.product_key = p.product_key\nLEFT JOIN tpch_dev.gold.dim_supplier AS s\n  ON f.supplier_key = s.supplier_key",
        "measures": [
          {
            "name": "net_revenue",
            "expr": "SUM(`extended_price` * (1 - `discount_rate`))",
            "displayName": "Net Revenue",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "abbreviation": "compact",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "order_count",
            "expr": "COUNT(DISTINCT `order_key`)",
            "displayName": "Distinct Orders"
          },
          {
            "name": "active_customers",
            "expr": "COUNT(DISTINCT `customer_key`)",
            "displayName": "Active Customers"
          },
          {
            "name": "avg_order_value",
            "expr": "SUM(`extended_price` * (1 - `discount_rate`)) / COUNT(DISTINCT `order_key`)",
            "displayName": "Average Order Value",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "abbreviation": "compact",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_discount",
            "expr": "AVG(`discount_rate`)",
            "displayName": "Average Discount Rate",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_ship_days",
            "expr": "AVG(DATEDIFF(`ship_date`, `order_date`))",
            "displayName": "Average Shipping Days",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "supplier_revenue_share",
            "expr": "MEASURE(`net_revenue`) / ANY_VALUE(`total_net_revenue`)",
            "displayName": "Supplier Revenue Share",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ],
        "version": "1.1",
        "comment": "TPC-H Gold sales analysis with joined dimensions and KPI measures",
        "dimensions": [
          {
            "name": "order_date",
            "expr": "order_date",
            "format": {
              "type": "date",
              "dateFormat": "year_month_day"
            }
          },
          {
            "name": "customer_name",
            "expr": "customer_name"
          },
          {
            "name": "customer_region",
            "expr": "customer_region"
          },
          {
            "name": "customer_nation",
            "expr": "customer_nation"
          },
          {
            "name": "market_segment",
            "expr": "customer_market_segment"
          },
          {
            "name": "product_name",
            "expr": "product_name"
          },
          {
            "name": "supplier_name",
            "expr": "supplier_name"
          },
          {
            "name": "supplier_nation",
            "expr": "supplier_nation"
          },
          {
            "name": "supplier_region",
            "expr": "supplier_region"
          },
          {
            "name": "ship_mode",
            "expr": "ship_mode"
          },
          {
            "name": "total_net_revenue",
            "expr": "SUM(`extended_price` * (1 - `discount_rate`)) OVER ()"
          }
        ]
      }
    }
  ],
